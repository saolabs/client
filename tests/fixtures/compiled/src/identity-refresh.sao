@state(items = [{id: 1, name: 'one'}, {id: 2, name: 'two'}])
<template>
<ul>
@foreach(items as item)
<li data-id="{{ item['id'] }}"><input><span>{{ item['name'] }}:{{ loop.index }}</span></li>
@endforeach
</ul>
</template>
<script setup>
export default {
    reverse() { setItems([...items].reverse()); },
    prepend() { setItems([{id: 3, name: 'three'}, ...items]); }
}
</script>
